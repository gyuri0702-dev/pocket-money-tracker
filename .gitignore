.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Supabase / API 키가 담긴 설정 파일
*.secret
secrets.json
config.secret.js

# ── Kiro IDE 설정 ────────────────────────────────────────
.kiro/

# ── Node.js 의존성 ───────────────────────────────────────
